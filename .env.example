# ─────────────────────────────────────────────────────────────────────────────
# NOVA — Environment Configuration Template
# Copy this to .env and edit to customise.
# .env is listed in .gitignore and will NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Server
NOVA_HOST=127.0.0.1
NOVA_PORT=7860

# ── Local LLM (Ollama) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# Recommended models by VRAM:
#   ≤4 GB VRAM  : llama3.2:1b    (fastest)
#   6 GB VRAM   : llama3.2:3b    ← DEFAULT — good for RTX 3050
#   ≥8 GB VRAM  : llama3.1:8b    (smarter)
#   CPU only    : llama3.2:1b or phi3:mini
NOVA_LLM_MODEL=llama3.2:3b

# LLM request timeout (seconds)
NOVA_LLM_TIMEOUT=120

# Enable streaming token-by-token responses
NOVA_LLM_STREAM=true
NOVA_LLM_MAX_TOKENS=2048
NOVA_LLM_TEMPERATURE=0.7

# ── Vision ────────────────────────────────────────────────────────────────────
# Pull with: ollama pull moondream
NOVA_VISION_MODEL=moondream
NOVA_VISION_ENABLED=true
NOVA_CAMERA_INDEX=0

# ── Speech-to-Text ────────────────────────────────────────────────────────────
NOVA_STT_ENGINE=faster-whisper
# Model sizes: tiny (~75MB) | base (~145MB) | small (~460MB) | medium (~1.5GB)
NOVA_STT_MODEL=base
# Language: auto (auto-detects English, Marathi, Hindi) | en | hi | mr
NOVA_STT_LANGUAGE=auto
# Device: auto | cpu | cuda
# Set cuda if you have CUDA Toolkit + cuDNN installed (RTX 3050 supported)
NOVA_STT_DEVICE=auto

# ── Text-to-Speech ────────────────────────────────────────────────────────────
# Engine: pyttsx3 (uses Windows SAPI5) or piper
NOVA_TTS_ENGINE=pyttsx3
NOVA_TTS_ENABLED=false
NOVA_TTS_RATE=175
NOVA_TTS_VOLUME=0.9

# ── Memory ────────────────────────────────────────────────────────────────────
# How many turns to keep in the active context window
NOVA_SHORT_TERM_TURNS=20
NOVA_MEMORY_ENABLED=true

# ── Privacy ───────────────────────────────────────────────────────────────────
NOVA_OFFLINE_MODE=true

# ── Logging ───────────────────────────────────────────────────────────────────
NOVA_LOG_LEVEL=INFO
